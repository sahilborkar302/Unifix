# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local MongoDB / Compass (default):
MONGODB_URI=mongodb://127.0.0.1:27017/unifix
# Atlas (later): replace the line above with your Atlas link, e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unifix?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS (frontend dev server) ----
CLIENT_ORIGIN=http://localhost:5173
